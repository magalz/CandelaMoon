#!/usr/bin/env bash
# validate-design - MVP design validator for candelamoon-docs
# ----------------------------------------------------------------------------
# Per ci-architecture.md § "candelamoon-docs" § "Installed tools":
#   "design validator entrypoint (validate-design - schema validation of
#    architecture schemas, ADR register, capability matrix, evidence
#    manifest); ADR/capability-matrix validation scripts."
#
# MVP scope (P1-002): assert that every required tool is installed and
# runnable, and exit non-zero if any tool is missing, broken, or not the
# exact pinned version. Real validation against /workspace/docs content
# (architecture schemas, ADR register, capability matrix, evidence
# manifest) is a P1-017 follow-up task; this script is the placeholder
# that the follow-up will extend.
#
# Fail-closed contract: any missing or broken tool exits 1 and the script
# prints an ERROR line per failing tool. Unknown or extra arguments exit 2
# with usage on stderr (B-16 / BAR-008). The on-host caller (the
# docs-validate CI job) treats a non-zero exit as a hard build failure.
#
# Import isolation (SEC-01): this script runs with WORKDIR /workspace, the
# bind-mounted repository — attacker-controlled content. Python checks
# therefore run with `python3 -I` (isolated mode: the current directory,
# PYTHONPATH, and user site-packages are NOT on sys.path), and the script
# cd's to / at startup so no check ever resolves files relative to the
# repository. Future P1-017 validator code must import its own trusted
# code from an image path and pass explicit /workspace paths.
#
# Network policy: this script is designed to run with --network=none at
# run time (per ci-architecture.md § "candelamoon-docs" § "Run-time
# network: none - all validation is file-based and offline"). It must
# not make any network calls. Every check is additionally bounded by
# `timeout 30` so a hung tool cannot hang the job (BAR-015).
#
# Usage:
#   validate-design              # concise (OK / ERROR lines only)
#   validate-design --verbose    # also print version + path per tool
# ----------------------------------------------------------------------------
set -eu

# SEC-01: never let any check run with the bind-mounted repository as its
# working directory. /workspace is attacker-controlled content (the repo
# checkout); running every probe from / means tools that resolve files
# relative to the CWD (Python imports, markdownlint config discovery, ...)
# cannot consult it. The Python checks additionally use -I (see below).
# Future P1-017 document validation must use explicit /workspace paths.
cd /

verbose=0
if [ "$#" -gt 1 ]; then
    printf 'ERROR: too many arguments: %s\n' "$*" >&2
    printf 'Usage: validate-design [--verbose]\n' >&2
    exit 2
fi
if [ "$#" -eq 1 ]; then
    if [ "$1" = "--verbose" ]; then
        verbose=1
    else
        printf 'ERROR: unknown argument: %s\n' "$1" >&2
        printf 'Usage: validate-design [--verbose]\n' >&2
        exit 2
    fi
fi

fail=0

# report <label> <status> [details]
# status: OK | ERROR
report() {
    local label=$1 status=$2 details=${3:-}
    if [ "$status" = "OK" ]; then
        if [ "$verbose" -eq 1 ]; then
            printf '  [validate-design] OK:    %-22s %s\n' "$label" "$details"
        else
            printf 'OK: %s\n' "$label"
        fi
    else
        printf 'ERROR: %s%s\n' "$label" "${details:+ ($details)}" >&2
    fi
}

# check <label> <expected-pattern> <command...>
# Run the command under `timeout 30`; on success, run the anchored
# pattern against the output. On timeout (exit 124) report a distinct
# TIMEOUT error (BAR-015). On any other failure (non-zero exit, empty
# output, or pattern miss) record an ERROR and bump `fail`. The
# `&& rc=0 || rc=$?` guard suppresses `set -e` so the script does not
# abort on the first miss.
check() {
    local label=$1 pattern=$2
    shift 2
    local out rc first
    out=$(timeout 30 "$@" 2>&1) && rc=0 || rc=$?
    if [ "$rc" -eq 124 ]; then
        report "$label" "ERROR" "timed out after 30s"
        fail=1
        return
    fi
    first=$(printf '%s' "$out" | head -n 1)
    if [ "$rc" -eq 0 ] && [ -n "$out" ] && printf '%s' "$out" | grep -qE "$pattern"; then
        if [ "$verbose" -eq 1 ]; then
            # Truncate the version / path line to a single line for log
            # legibility; multi-line output is collapsed to the first line.
            report "$label" "OK" "$first"
        else
            report "$label" "OK"
        fi
    elif [ -z "$out" ]; then
        report "$label" "ERROR" "command produced no output (exit $rc)"
        fail=1
    else
        report "$label" "ERROR" "exit $rc; output did not match /$pattern/: $first"
        fail=1
    fi
}

# --- Python 3.11 (from the base image, fixed by the digest pin) -----------
# python3 prints "Python 3.11.15"; the anchored pattern pins major.minor
# (any 3.11.x patch is acceptable per toolchain-pins.md § "Python 3.11" —
# the patch level is fixed by the base-image digest, not by this check).
check "python3"              '^Python 3\.11\.'               python3 --version

# --- Node.js 22.x (from the official tarball, SHA-256 pinned) -------------
# node prints "v22.23.2"; the anchored pattern pins the LTS major (any
# 22.x.y patch is acceptable per toolchain-pins.md § "Node.js 22 LTS" —
# the patch is fixed by the SHA-256-pinned tarball).
check "node"                 '^v22\.'                        node --version

# --- npm (sibling to node; bundled with the pinned Node tarball) ----------
# npm prints just a version number; the exact pin is the version shipped
# inside the pinned Node 22.23.2 tarball (toolchain-pins.md § "Node").
check "npm"                  '^10\.9\.8$'                    npm --version

# --- Python pip tools (per ci-architecture.md § "candelamoon-docs") -------
# Each check imports the REAL module and prints its __version__, then the
# anchored pattern asserts the exact pinned version (B-15 / BAR-006: a
# stale or corrupted .dist-info cannot pass — the import itself must
# succeed; B-14 / BAR-007: a different version cannot match). jsonschema
# and pyyaml are checked separately so a failure names the failing
# package precisely (the triaged patch suggested one combined command;
# splitting keeps one command per check so failures stay attributable).
# SEC-01: `python3 -I` runs in isolated mode — the current directory
# (/workspace, the bind-mounted repo) is NOT added to sys.path, so a
# repo-root jsonschema.py or yaml.py cannot hijack the import, execute
# attacker code as builder, or spoof the expected __version__. Combined
# with the `cd /` at startup, no workspace file can satisfy or shadow
# these imports.
check "jsonschema"           '^4\.23\.0$'                    python3 -I -c "import jsonschema; print(jsonschema.__version__)"
check "pyyaml"               '^6\.0\.2$'                     python3 -I -c "import yaml; print(yaml.__version__)"
# yamllint prints "yamllint 1.37.1" (with a leading product name); the
# anchored pattern includes the exact product prefix and version.
check "yamllint"             '^yamllint 1\.37\.1$'          yamllint --version

# --- npm global tools (per ci-architecture.md § "candelamoon-docs") -------
# markdownlint-cli prints just a version ("0.45.0"); markdown-link-check
# prints just a version ("3.13.7"). Anchored exact pins (B-14 / BAR-007).
check "markdownlint"         '^0\.45\.0$'                    markdownlint --version
check "markdown-link-check"  '^3\.13\.7$'                    markdown-link-check --version

# --- Final summary --------------------------------------------------------
if [ "$fail" -ne 0 ]; then
    printf 'ERROR: design validator missing or broken tools (run with --verbose for details)\n' >&2
    exit 1
fi
printf 'OK: all design validator tools present and runnable\n'
exit 0
