{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magalz/CandelaMoon/.maestro-space/maestro-templates/agent-output.schema.json",
  "title": "Maestro Agent Output",
  "description": "Canonical JSON schema for every agent's structured output. The matching .md file is the human narrative companion; together they form the artifact (Decision A: JSON+MD hybrid).",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "agent",
    "task",
    "data",
    "emitted_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver version of this schema the artifact was emitted against. Lets future schema migrations detect old artifacts."
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "activity-report",
        "findings",
        "atdd-checklist",
        "coverage-audit",
        "post-phase-report",
        "post-phase-summary",
        "maintenance-plan",
        "handoff"
      ]
    },
    "agent": {
      "type": "object",
      "required": ["name", "role", "subagent_type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Logical agent name (e.g., 'Senior Developer', 'Blind Hunter')."
        },
        "role": {
          "type": "string",
          "description": "One-line role description."
        },
        "subagent_type": {
          "type": "string",
          "description": "The subagent_type string used in the dispatch call (e.g., 'senior-developer', 'blind-hunter')."
        },
        "dispatched_by": {
          "type": "string",
          "description": "Identifier of the dispatcher (typically the orchestrator session id)."
        },
        "task_id": {
          "type": "string",
          "description": "Subagent task_id used for re-dispatch / context continuity. Opaque ULID or similar."
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["change_id", "phase", "branch"],
      "properties": {
        "change_id": {
          "type": "string",
          "description": "Task ID (e.g., 'P1-021', 'M1-001')."
        },
        "phase": {
          "type": "string",
          "pattern": "^Phase \\d+$"
        },
        "phase_short": {
          "type": "string",
          "description": "Kebab-case short form used in folder paths (e.g., 'phase-1-delivery-system')."
        },
        "branch": {
          "type": "string"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "pr_url": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Artifact-specific payload. The shape depends on artifact_type; documented alongside each template in maestro-templates/.",
      "additionalProperties": true
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of when the agent emitted the artifact."
    },
    "narrative_path": {
      "type": "string",
      "description": "Path to the matching .md narrative file, relative to the task folder."
    }
  },
  "allOf": [
    {
      "description": "When artifact_type is 'findings', the data payload MUST include an array of finding objects.",
      "if": {
        "properties": { "artifact_type": { "const": "findings" } }
      },
      "then": {
        "properties": {
          "data": {
            "required": ["review_phase", "findings"],
            "properties": {
              "review_phase": {
                "type": "integer",
                "enum": [1, 2]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "severity", "detail", "location"],
                  "properties": {
                    "id": { "type": "string", "description": "Agent-local id (e.g., 'B-01', 'E-03', 'A-02', 'SEC-01')." },
                    "title": { "type": "string" },
                    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical", "info"] },
                    "detail": { "type": "string" },
                    "location": {
                      "type": "object",
                      "properties": {
                        "file_path": { "type": "string" },
                        "line": { "type": "integer" },
                        "symbol": { "type": "string" }
                      }
                    },
                    "suggested_route": {
                      "type": "string",
                      "enum": ["patch", "defer", "dismiss", "decision-needed"]
                    },
                    "evidence": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "When artifact_type is 'activity-report', the data payload MUST include actions, files, and verification.",
      "if": {
        "properties": { "artifact_type": { "const": "activity-report" } }
      },
      "then": {
        "properties": {
          "data": {
            "required": ["actions", "files", "verification"],
            "properties": {
              "actions": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Free-text list of concrete actions taken by the agent in this dispatch."
              },
              "files": {
                "type": "object",
                "properties": {
                  "created": { "type": "array", "items": { "type": "string" } },
                  "modified": { "type": "array", "items": { "type": "string" } }
                }
              },
              "verification": {
                "type": "object",
                "description": "Evidence the agent collected (commands run, test counts, etc.)",
                "additionalProperties": true
              },
              "deviations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "known_issues": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
